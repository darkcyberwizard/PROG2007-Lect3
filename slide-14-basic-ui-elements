        super.onCreate(savedInstanceState)
        enableEdgeToEdge()
        setContent {
            UIUXTestAppTheme {
                Scaffold(modifier = Modifier.fillMaxSize()) { innerPadding ->
                    Box(modifier = Modifier.padding(innerPadding).padding(16.dp)) {
                        SimpleForm() // swap to SimpleOutlinedForm() to test the other one
