package com.example.uiuxtestapp

import android.os.Bundle
import androidx.activity.ComponentActivity
import androidx.activity.compose.setContent
import androidx.activity.enableEdgeToEdge
import androidx.compose.foundation.background
import androidx.compose.foundation.layout.Box
import androidx.compose.foundation.layout.Column
import androidx.compose.foundation.layout.Row
import androidx.compose.foundation.layout.Spacer
import androidx.compose.foundation.layout.fillMaxSize
import androidx.compose.foundation.layout.height
import androidx.compose.foundation.layout.padding
import androidx.compose.foundation.layout.width
import androidx.compose.material3.Card
import androidx.compose.material3.MaterialTheme
import androidx.compose.material3.Scaffold
import androidx.compose.material3.Text
import androidx.compose.runtime.Composable
import androidx.compose.ui.Modifier
import androidx.compose.ui.tooling.preview.Preview
import androidx.compose.ui.unit.dp
import com.example.uiuxtestapp.ui.theme.UIUXTestAppTheme

class MainActivity : ComponentActivity() {
    override fun onCreate(savedInstanceState: Bundle?) {
        super.onCreate(savedInstanceState)
        enableEdgeToEdge()
        setContent {
            UIUXTestAppTheme {
                Scaffold(modifier = Modifier.fillMaxSize()) { innerPadding ->
                    Box(modifier = Modifier.padding(innerPadding)) {
                        ThemeShowcase()
                    }
                }
            }
        }
    }
}

@Composable
fun ThemeShowcase() {
    Column(modifier = Modifier.padding(16.dp)) {

        Text(text = "Display", style = MaterialTheme.typography.displaySmall)
        Text(text = "Headline", style = MaterialTheme.typography.headlineSmall)
        Text(text = "Title", style = MaterialTheme.typography.titleMedium)
        Text(text = "Body", style = MaterialTheme.typography.bodyLarge)
        Text(text = "Label", style = MaterialTheme.typography.labelSmall)

        Spacer(modifier = Modifier.height(16.dp))

        Row {
            Box(
                modifier = Modifier
                    .background(MaterialTheme.colorScheme.primary)
                    .padding(12.dp)
            ) {
                Text(text = "Primary", color = MaterialTheme.colorScheme.onPrimary)
            }
            Spacer(modifier = Modifier.width(8.dp))
            Box(
                modifier = Modifier
                    .background(MaterialTheme.colorScheme.secondary)
                    .padding(12.dp)
            ) {
                Text(text = "Secondary", color = MaterialTheme.colorScheme.onSecondary)
            }
            Spacer(modifier = Modifier.width(8.dp))
            Box(
                modifier = Modifier
                    .background(MaterialTheme.colorScheme.error)
                    .padding(12.dp)
            ) {
                Text(text = "Error", color = MaterialTheme.colorScheme.onError)
            }
        }

        Spacer(modifier = Modifier.height(16.dp))

        Card(shape = MaterialTheme.shapes.medium) {
            Text(
                text = "A Card, using the theme's shape and surface color",
                modifier = Modifier.padding(12.dp)
            )
        }
    }
}

@Preview(showBackground = true)
@Composable
fun DefaultPreview() {
    UIUXTestAppTheme {
        ThemeShowcase()
    }
}
